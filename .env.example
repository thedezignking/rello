# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only (Phase 4+). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
OPENROUTER_API_KEY=

# PDF export (optional). Local dev finds Chrome or Edge automatically.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Origin headless Chrome loads /print from, if it can't reach the request's own origin
# (e.g. behind Vercel deployment protection).
# PDF_RENDER_ORIGIN=https://rello.example.com

# Sign-in code emails need your own sender on Supabase's free plan.
# `npm run auth:emails` connects it and switches the emails to codes.
SUPABASE_ACCESS_TOKEN=
# Resend (recommended): just the API key. SMTP_FROM is optional until you
# verify a domain in Resend (then e.g. Rello <hello@yourdomain.com>).
RESEND_API_KEY=
SMTP_FROM=
# Or any other SMTP provider instead of Resend:
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
