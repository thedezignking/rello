# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only (Phase 4+). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
OPENROUTER_API_KEY=

# Paystack: server-only secret key. Use test keys before enabling live payments.
PAYSTACK_SECRET_KEY=
# Timestamped webhook signing secret (whsec_...), when enabled in Paystack.
PAYSTACK_WEBHOOK_SECRET=
# Canonical HTTPS app origin, used for payment return URLs in production.
NEXT_PUBLIC_SITE_URL=
# NGN per 1 USD. Set an explicit rate to offer NGN checkout alongside USD.
# Existing orders keep the amount quoted when checkout began.
PAYSTACK_NGN_PER_USD=

# PDF export (optional). Local dev finds Chrome or Edge automatically.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Origin headless Chrome loads /print from, if it can't reach the request's own origin
# (e.g. behind Vercel deployment protection).
# PDF_RENDER_ORIGIN=https://rello.example.com

# Sign-in code emails need your own sender on Supabase's free plan.
# `npm run auth:emails` connects it and switches the emails to codes.
SUPABASE_ACCESS_TOKEN=
# Resend: API key and an address on a verified domain. The onboarding
# sender cannot deliver customer sign-in emails.
RESEND_API_KEY=
SMTP_FROM=
# Auth emails per hour across the project; each recipient still waits 60s.
AUTH_EMAIL_RATE_LIMIT=30

# Environment and deployment checks. Never enable demo mode in production.
APP_ENV=development
AI_DEMO_MODE=false
DAILY_AI_CAP=40
# Optional scrubbed error reporting; configure alerts in the Sentry project.
NEXT_PUBLIC_SENTRY_DSN=

# Migration variables: export explicitly in your shell before db:migrate.
# SUPABASE_DB_URL=postgresql://...
# MIGRATION_DB_HOST=db.your-project.supabase.co
# SUPABASE_DB_CA_FILE=/absolute/path/to/project-ca.crt
# Disposable integration-test database only; loopback and rello_test are enforced.
# TEST_DATABASE_URL=postgresql://postgres:local_test_only@127.0.0.1:5432/rello_test
# Or any other SMTP provider instead of Resend:
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
